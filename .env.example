# =============================================================================
# Aryan Sharma Portfolio — Backend & Notification Configuration
# =============================================================================

# Server Port & Environment
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Email Notification Settings
# The inbox where contact messages will be delivered:
CONTACT_EMAIL=aryan21sharma04@gmail.com
# From address displayed on incoming notification emails:
EMAIL_FROM="Portfolio Notifications" <aryan21sharma04@gmail.com>

# SMTP Transporter Configuration
# Option A: Gmail SMTP (Recommended: Use a 16-character Google App Password)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under "App Passwords" (select App: Mail, Device: Portfolio)
# 3. Paste the generated 16-character password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aryan21sharma04@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here

# Option B: Custom SMTP (Resend, SendGrid, Postmark, AWS SES, Mailgun, etc.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_123456789_abcdef

# Admin API Secret Key
# Protects administrative message retrieval, status updates, and deletions (/api/admin/messages)
# Generate a strong random key: e.g. run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_API_KEY=aryan_portfolio_admin_secret_key_change_in_production

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aryansharma.dev,https://portfolio-amber-rho-jwa3w6ztpg.vercel.app
